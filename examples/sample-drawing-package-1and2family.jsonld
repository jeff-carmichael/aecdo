        {
          "@id": "urn:uuid:e3e74bda-703a-5474-8160-023cb1685be9",
          "@type": "Table",
          "label": "Wall Assembly Effective R Value",
          "content": "Wall assembly | Assembly | Effective R value | Effective RSI\n2x8 @ 24\" O.C. R-28 HD batt | Exterior air film | R- 0.17 | RSI- 0.03\n | Cladding (Hardy board) | R- 0.10 | RSI- 0.018\n | Vented air space (1/2\" - 3/4\" rain screen) | R- 0.85 | RSI- 0.15\n | Building wrap | R- 0 | RSI- 0\n | 5/8\" exterior grade plywood sheathing | R- 0.62 | RSI- 0.11\n | 2x8 @ 24\" O.C. with R28 HD batt | R- 19.53 | RSI- 3.44\n | 0.6mm poly UV A/V barrier | R- 0 | RSI- 0\n | 1/2\" gypsum wall board | R- 0.45 | RSI- 0.08\n | Interior air film | R- 0.68 | RSI- 0.12\n | Total effective R value | R- 22.44 | RSI- 3.95",
          "bbox": [
