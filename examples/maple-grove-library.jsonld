          "@id": "urn:uuid:42ebe11d-d051-5c02-aab6-38f68cfc5b7a",
          "@type": "Table",
          "label": "Exterior Materials Legend",
          "content": "Tag | Material | Manufacturer / Color\nBR-1 | Modular face brick | Ironspot charcoal, running bond\nMP-1 | Metal composite panel | Copper tone Kynar\nCW-1 | Unitized curtain wall | Clear anodized aluminum\nSF-1 | Storefront | Clear anodized aluminum\nCP-1 | Parapet coping | Prefinished, match MP-1",
          "bbox": [
            1500,
            100,
            2150,
            400
          ]
        }
      ],
      "notes": [
        {
          "@id": "urn:uuid:7443e93d-8908-584c-a512-6ec54ecf857f",
          "@type": "Note",
          "content": "GENERAL NOTES:\n1. All exposed fasteners to match adjacent finish.\n2. Provide mockup panel of BR-1, MP-1 and CW-1 for architect approval prior to procurement.",
          "bbox": [
            1500,
            450,
            2150,
            600
          ]
        }
