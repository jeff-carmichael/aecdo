      "notes": [
        {
          "@id": "urn:uuid:aff778d3-f7c1-5c08-b478-5870f8080c76",
          "@type": "Note",
          "content": "GENERAL NOTES:\n1. Coordinate all duct routing with structural framing; maximum duct depth 20\" below W21 girders.\n2. Provide fire/smoke dampers at all rated wall penetrations.\n3. Balance all air devices to within 10% of scheduled values.\n4. Demand-controlled ventilation via CO2 sensors in assembly spaces.",
          "bbox": [
            1800,
            110,
            2190,
            420
          ]
        }
