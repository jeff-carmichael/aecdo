      "notes": [
        {
          "@id": "urn:uuid:64a8abc9-4788-54c7-9a0e-1b2240f1af3b",
          "@type": "Note",
          "content": "GENERAL NOTES:\n1. Fire extinguisher cabinets: provide within 75 ft travel distance of all areas; final locations by fire marshal.\n2. Stair enclosures are 2-hr rated with 90-minute doors; elevator shaft is 1-hr with 60-minute door.\n3. Doors in the path of egress serving rooms over 49 occupants swing in the direction of egress travel and have panic hardware.\n4. Provide exit signs and emergency lighting per E101.",
          "bbox": [
            100,
            950,
            1100,
            1200
          ]
        }
      ],
