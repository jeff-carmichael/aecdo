    {
      "@id": "urn:uuid:8f7a5277-fe57-5ec5-a5dc-180a7e790bd2",
      "@type": "Sheet",
      "sheetNumber": "E601",
      "title": "Electrical Panel Schedules",
      "pageIndex": 18,
      "tables": [
        {
          "@id": "urn:uuid:1f809ed2-c55b-54ff-829f-d799be430335",
          "@type": "Table",
          "label": "Main Switchboard MSB",
          "content": "Item | Value\nService | 1200A, 480Y/277V, 3ph, 4W\nFault rating | 65 kAIC\nFeeders | LP-1 (225A), LP-2 (225A), RP-1 via T1 (150A), RTU-1/2/3, ELEV (100A), FP (60A)\nMetering | Utility CT cabinet + EV submeter",
          "bbox": [
            100,
            100,
            1000,
            350
          ]
        },
        {
          "@id": "urn:uuid:cd8d0915-5aba-5933-a495-3c701edf523b",
