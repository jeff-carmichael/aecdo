      "notes": [
        {
          "@id": "urn:uuid:253ec7aa-4e12-5d1c-b9b0-50a529f0ea95",
          "@type": "Note",
          "content": "GENERAL NOTES:\n1. All dimensions are to face of stud or face of CMU unless noted otherwise.\n2. Verify all dimensions in field prior to fabrication of millwork and storefront.\n3. Provide fire-treated wood blocking at all wall-mounted shelving, casework, grab bars, and accessories.\n4. All interior partitions are type 2 unless noted otherwise. See wall types on this sheet.\n5. Open commons 218 is open to the lobby below; see guardrail detail 5/A501.",
          "bbox": [
            1800,
            110,
            2190,
            420
          ]
        }
