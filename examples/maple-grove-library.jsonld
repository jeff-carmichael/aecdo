      "notes": [
        {
          "@id": "urn:uuid:95ac9c84-95ce-5506-a8f8-a13a8fdb4012",
          "@type": "Note",
          "content": "PROJECT DESCRIPTION: New two-story, 36,000 SF branch library on a 3.2-acre site. Steel frame on spread footings with brick and CMU exterior, aluminum curtain wall at the south reading rooms, and a low-slope TPO roof with rooftop HVAC units. Program includes children's library, story time room, community room with kitchenette, adult collection, teen zone, makerspace, computer lab, four study rooms, and staff areas. Target: LEED Silver.",
          "bbox": [
            100,
            1100,
            1100,
            1280
          ]
        }
      ],
