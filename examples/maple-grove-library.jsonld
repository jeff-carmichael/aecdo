      "tables": [
        {
          "@id": "urn:uuid:46552571-e7b6-5c8d-a242-b43287fa9d61",
          "@type": "Table",
          "label": "Light Fixture Schedule",
          "content": "Type | Description | Lamp | Watts | Mounting | Notes\nA | 2x4 LED troffer | LED 3500K, 90 CRI | 32 | Recessed in ACT | 0-10V dimming\nB | Linear LED pendant | LED 3500K, 90 CRI | 40 (per 8 ft) | Pendant at 10'-0\" AFF | Up/down light, 0-10V\nC | 6\" LED downlight | LED 3000K | 14 | Recessed | Wet location at restrooms\nD | LED wall pack (exterior) | LED 4000K | 28 | Wall, 12'-0\" AFF | Full cutoff, dark sky\nX | LED exit sign | LED | 3 | Ceiling / wall | Battery backup, 90 min\nEM | Emergency battery unit | LED twin head | 6 | Wall, 8'-0\" AFF | Self-test",
          "bbox": [
            1800,
            110,
            2190,
            500
          ]
        },
        {
          "@id": "urn:uuid:a6403647-c8fd-546b-8a90-60156c182506",
          "@type": "Table",
          "label": "Lighting Power Density (IECC C405.3)",
          "content": "Area | Allowed (W/SF) | Installed watts | Installed (W/SF)\nLevel 1 (library) | 0.83 | 6396 | 0.36",
          "bbox": [
            1800,
            550,
            2190,
            650
          ]
        }
      ],
      "notes": [
        {
          "@id": "urn:uuid:f010d078-a354-56a4-b0f5-f214d9010a2a",
          "@type": "Note",
          "content": "GENERAL NOTES:\n1. All interior lighting on 277V circuits from panel LP-1 unless noted.\n2. Provide daylight-responsive controls within primary daylit zones along south curtain wall.\n3. Emergency lighting to provide 1 fc average along the path of egress for 90 minutes.",
          "bbox": [
            1800,
            700,
            2190,
            900
          ]
        }
      ],
