{
  "name": "aecdo",
  "version": "0.4.0",
  "description": "CLI and schema for processing AEC drawing data (JSON-LD) conforming to the AEC Drawing Ontology.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "aecdo": "./dist/bin/aecdo.js"
  },
  "exports": {
    "./schema": "./ontology/v0.3.0/aecdo.schema.json",
    "./context": "./ontology/v0.3.0/context.jsonld"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "ontology/",
    "examples/",
    ".claude/",
    "scripts/postinstall.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build",
    "build": "tsc -p cli/tsconfig.json",
    "build:bin": "bun build cli/bin/standalone.ts --compile --minify --outfile dist-bin/aecdo",
    "build:bin:darwin-x64": "bun build cli/bin/standalone.ts --compile --minify --target=bun-darwin-x64 --outfile dist-bin/darwin-x64/aecdo",
    "build:bin:darwin-arm64": "bun build cli/bin/standalone.ts --compile --minify --target=bun-darwin-arm64 --outfile dist-bin/darwin-arm64/aecdo",
    "build:bin:linux-x64": "bun build cli/bin/standalone.ts --compile --minify --target=bun-linux-x64 --outfile dist-bin/linux-x64/aecdo",
    "build:bin:linux-arm64": "bun build cli/bin/standalone.ts --compile --minify --target=bun-linux-arm64 --outfile dist-bin/linux-arm64/aecdo",
    "build:bin:windows-x64": "bun build cli/bin/standalone.ts --compile --minify --target=bun-windows-x64 --outfile dist-bin/windows-x64/aecdo.exe",
    "build:bin:all": "bun run build:bin:darwin-x64 && bun run build:bin:darwin-arm64 && bun run build:bin:linux-x64 && bun run build:bin:linux-arm64 && bun run build:bin:windows-x64",
    "prebuild": "node -e \"import('node:fs').then(f=>f.promises.rm('dist',{recursive:true,force:true}))\"",
    "test": "npm run build && node --test dist/src/**/*.test.js",
    "lint": "eslint cli/",
    "diagram": "node scripts/generate-diagram.mjs",
    "diagram:check": "node scripts/generate-diagram.mjs --check",
    "setup": "git config core.hooksPath .githooks",
    "aecdo": "node dist/bin/aecdo.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "aec",
    "architecture",
    "engineering",
    "construction",
    "drawings",
    "json-ld",
    "ontology",
    "drawingbot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jeff-carmichael/aecdo.git"
  },
  "homepage": "https://aecdrawingbot.com"
}
