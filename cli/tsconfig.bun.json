{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // webview-bun ships Bun-style TypeScript; check against the declarations we use instead.
    "paths": { "webview-bun": ["./bin/webview-bun.d.ts"] }
  },
  "include": ["bin/standalone.ts", "bin/embed-assets.ts", "bin/gui-window.ts"],
  "exclude": []
}
