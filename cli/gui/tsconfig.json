{
  // Type-checks the app's plain JavaScript (JSDoc types) as part of "npm run lint"; nothing is emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["*.js"]
}
